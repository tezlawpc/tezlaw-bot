+    if (/FROM matters WHERE id = \$1/.test(sql)) return { rows: MATTERS[params[0]] ? [{ notes: "old notes", mark: "TEZ", serial_number: "99123456", matter_ref: "99123456", client_name: "C" }] : [] };
