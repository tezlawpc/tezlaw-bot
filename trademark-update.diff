+        stats.alertsSent++;
+        await db.query(`UPDATE tm_tsdr_status SET last_alerted_at = NOW(), last_alerted_code = last_error_code WHERE matter_id = ANY($1::int[])`, [toReport.map(f => f.matterId)]);
