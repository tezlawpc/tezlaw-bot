+        parts.push(`™️ USPTO check done: ${stats.checked} matter(s) checked, ${stats.changed} with news, ${stats.deadlinesAdded} deadline(s) added, ${stats.errors} error(s). ${stats.alertsSent} alert message(s) sent separately.`);
